{
  "manifest_version": 3,
  "name": "Limeris votes",
  "version": "0.1.1",
  "description": "Rappels et file de vote pour les serveurs Minecraft : sois prévenu dès qu'un site de vote redevient disponible. Développée par Sliver91.",
  "homepage_url": "https://limeris.fr",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Limeris votes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications", "sidePanel", "offscreen", "clipboardWrite"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
